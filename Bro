local targetPlayer = nil
local function findPlayer(str)
    str = str:lower()
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name:lower():sub(1, #str) == str or p.DisplayName:lower():sub(1, #str) == str then return p end
    end
end

NameBox:GetPropertyChangedSignal("Text"):Connect(function()
    local text = NameBox.Text
    if text == "" then PredictionLabel.Text = ""; targetPlayer = nil; return end
    local found = findPlayer(text)
    if found then
        targetPlayer = found
        PredictionLabel.Text = text .. found.Name:sub(#text + 1)
    else
        PredictionLabel.Text = ""
        targetPlayer = nil
    end
end)

NameBox.FocusLost:Connect(function()
    if targetPlayer then NameBox.Text = targetPlayer.Name; PredictionLabel.Text = "" end
end)

local flying = false
local flyConnection

FlyBtn.MouseButton1Click:Connect(function()
    flying = not flying
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChild("Humanoid")
    
    if flying and hrp and hum then
        FlyBtn.Text = "FLY: ON"
        FlyGradient.Color = ColorSequence.new(Color3.fromRGB(35, 105, 55), Color3.fromRGB(15, 55, 25))
        
        local bv = Instance.new("BodyVelocity")
        bv.Name = "JoystickFlyVelocity"
        bv.MaxForce = Vector3.new(1e6, 1e6, 1e6)
        bv.Velocity = Vector3.zero
        bv.Parent = hrp
        
        local bg = Instance.new("BodyGyro")
        bg.Name = "JoystickFlyGyro"
        bg.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
        bg.CFrame = hrp.CFrame
        bg.Parent = hrp
        
        hum:ChangeState(Enum.HumanoidStateType.Physics)
        
        flyConnection = RunService.RenderStepped:Connect(function()
            if not hrp or not hrp.Parent or not hum then return end
            local camera = workspace.CurrentCamera
            
            bg.CFrame = camera.CFrame
            local moveDir = hum.MoveDirection
            
            if moveDir.Magnitude > 0 then
                local finalVelocity = moveDir * flySpeed
                local localMove = camera.CFrame:VectorToObjectSpace(moveDir)
                local verticalComponent = 0
                
                if localMove.Z < -0.1 then 
                    verticalComponent = camera.CFrame.LookVector.Y * flySpeed
                elseif localMove.Z > 0.1 then 
                    verticalComponent = -camera.CFrame.LookVector.Y * flySpeed
                end
                
                bv.Velocity = Vector3.new(finalVelocity.X, verticalComponent, finalVelocity.Z)
            else
                bv.Velocity = Vector3.zero
            end
            
            hrp.Velocity = Vector3.zero
        end)
    else
        FlyBtn.Text = "FLY: OFF"
        FlyGradient.Color = ColorSequence.new(Color3.fromRGB(35, 65, 105), Color3.fromRGB(15, 30, 55))
        
        if flyConnection then flyConnection:Disconnect() end
        if hrp then
            if hrp:FindFirstChild("JoystickFlyVelocity") then hrp.JoystickFlyVelocity:Destroy() end
            if hrp:FindFirstChild("JoystickFlyGyro") then hrp.JoystickFlyGyro:Destroy() end
        end
        if hum then 
            hum:ChangeState(Enum.HumanoidStateType.GettingUp) 
        end
    end
end)

local banging = false
local bangConnection

BangBtn.MouseButton1Click:Connect(function()
    banging = not banging
    if banging then
        if not targetPlayer or not targetPlayer.Character or not targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
            banging = false
            return
        end
        
        BangGradient.Color = ColorSequence.new(Color3.fromRGB(105, 35, 35), Color3.fromRGB(55, 15, 15))
        
        local myChar = LocalPlayer.Character
        local myHrp = myChar:WaitForChild("HumanoidRootPart")
        local myHum = myChar:WaitForChild("Humanoid")
        
        local animator = myHum:FindFirstChildOfClass("Animator")
        if animator then
            local animInstance = Instance.new("Animation")
            animInstance.AnimationId = "rbxassetid://180426354"
            pcall(function()
                local track = animator:LoadAnimation(animInstance)
                track.Name = "BangTrack"
                track:Play()
                track:AdjustSpeed(3.5)
            end)
        end
        
        bangConnection = RunService.Heartbeat:Connect(function()
            local tChar = targetPlayer.Character
            local tHrp = tChar and tChar:FindFirstChild("HumanoidRootPart")
            
            if tHrp and myHrp then
                local movement = math.sin(tick() * 35) * 0.9
                myHrp.CFrame = tHrp.CFrame * CFrame.new(0, 0, 1.1 + movement)
            else
                if bangConnection then bangConnection:Disconnect() end
            end
        end)
    else
        BangGradient.Color = ColorSequence.new(Color3.fromRGB(75, 60, 35), Color3.fromRGB(40, 30, 15))
        if bangConnection then bangConnection:Disconnect() end
        
        local myChar = LocalPlayer.Character
        local myHum = myChar and myChar:FindFirstChild("Humanoid")
        if myHum then
            local animator = myHum:FindFirstChildOfClass("Animator")
            if animator then
                for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                    if track.Name == "BangTrack" or track.Animation.AnimationId == "rbxassetid://180426354" then
                        track:Stop()
                    end
                end
            end
        end
    end
end)

