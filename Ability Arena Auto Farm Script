-- Пробуем найти сетевой модуль без require 
local Network = nil 
pcall(function() 
    Network = _G.Network or shared.Network 
end) 

task.spawn(function() 
    while true do 
        if farming then 
            pcall(function() 
                local character = LocalPlayer.Character 
                local rootPart = character and character:FindFirstChild("HumanoidRootPart") 
                if rootPart then 
                    local targetRoot = nil 
                    local shortestDist = math.huge 
                    
                    for _, player in ipairs(Players:GetPlayers()) do 
                        -- Проверка: не я сам, игрока нет в черном списке, и персонаж загружен
                        if player ~= LocalPlayer and not WhitelistedPlayers[player.Name] and player.Character then 
                            local tRoot = player.Character:FindFirstChild("HumanoidRootPart") 
                            local tHumanoid = player.Character:FindFirstChild("Humanoid") 
                            if tRoot and tHumanoid and tHumanoid.Health > 0 then 
                                local dist = (rootPart.Position - tRoot.Position).Magnitude 
                                if dist < shortestDist then 
                                    shortestDist = dist 
                                    targetRoot = tRoot 
                                end 
                            end 
                        end 
                    end 
                    
                    if targetRoot then 
                        -- Жесткий залет за спину цели 
                        rootPart.CFrame = targetRoot.CFrame * CFrame.new(0, 0, 3) 
                        
                        -- Если нашли Network, бьем напрямую через пакеты 
                        if Network and Network.Combat and Network.Combat.packets and Network.Combat.packets.AbilityActivated then 
                            Network.Combat.packets.AbilityActivated.send({ 
                                AbilityId = "Attack", 
                                ClientTime = workspace:GetServerTimeNow(), 
                                Victim = targetRoot.Parent, 
                                Position = rootPart.Position, 
                                Look = rootPart.CFrame.LookVector, 
                                VictimPosition = targetRoot.Position, 
                                Combo = 1 
                            }) 
                        else 
                            -- Альтернативный клик, если пакеты заблокированы 
                            local VirtualUser = game:GetService("VirtualUser") 
                            VirtualUser:CaptureController() 
                            VirtualUser:Button1Down(Vector2.new(0,0)) 
                        end 
                    end 
                end 
            end) 
        end 
        task.wait(0.1) 
    end 
end) 

