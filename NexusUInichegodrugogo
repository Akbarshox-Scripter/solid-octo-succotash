local Tabs = {}
local TabButtons = {}

local function CreateTab(name, index)
    local TabBtn = Instance.new("TextButton", Sidebar)
    TabBtn.Text = name
    TabBtn.Font = Enum.Font.GothamSemibold
    TabBtn.TextSize = 13
    TabBtn.TextColor3 = index == 1 and THEME.TextWhite or THEME.TextDark
    TabBtn.Size = UDim2.new(0.85, 0, 0, 36)
    TabBtn.Position = UDim2.new(0.075, 0, 0, 10 + ((index - 1) * 42))
    TabBtn.BackgroundTransparency = 1
    TabBtn.ZIndex = 2

    local Page = Instance.new("ScrollingFrame", ContentArea)
    Page.Size = UDim2.new(1, 0, 1, 0)
    Page.BackgroundTransparency = 1
    Page.Visible = (index == 1)
    Page.ScrollBarThickness = 2
    Page.ScrollBarImageColor3 = THEME.NeonPurple
    Page.BorderSizePixel = 0

    local Layout = Instance.new("UIListLayout", Page)
    Layout.Padding = UDim.new(0, 8)

    if index == 1 then
        TabIndicator.Position = TabBtn.Position
        TabIndicator.Visible = true
    end

    TabBtn.MouseButton1Click:Connect(function()
        for _, btn in pairs(TabButtons) do
            TweenService:Create(btn, TweenInfo.new(0.3), {TextColor3 = THEME.TextDark}):Play()
        end
        for _, p in pairs(Tabs) do p.Visible = false end

        -- Ультра-плавное перемещение индикатора (обводки)
        TweenService:Create(TabIndicator, TweenInfo.new(0.5, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), {
            Position = TabBtn.Position
        }):Play()

        TweenService:Create(TabBtn, TweenInfo.new(0.3), {TextColor3 = THEME.TextWhite}):Play()
        Page.Visible = true
    end)

    table.insert(TabButtons, TabBtn)
    table.insert(Tabs, Page)
    return Page
end

local function CreateToggle(parent, text, configKey, callback)
    local Card = Instance.new("Frame", parent)
