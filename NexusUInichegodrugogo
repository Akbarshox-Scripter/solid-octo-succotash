local function CreateTab(name, isActive)
    local Tab = Instance.new("TextButton")
    Tab.Size = UDim2.new(0.2, 0, 1, 0)
    Tab.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    Tab.BorderSizePixel = 1
    Tab.BorderColor3 = Color3.fromRGB(0,0,0)
    Tab.Text = name
    Tab.Font = Enum.Font.GothamBlack
    Tab.TextSize = 11
    Tab.TextColor3 = isActive and Color3.fromRGB(0, 0, 0) or Color3.fromRGB(255, 255, 255)
    
    if isActive then
        applyGradient(Tab, Color3.fromRGB(255, 230, 50), Color3.fromRGB(255, 150, 0)) -- Желто-оранжевый градиент для MAIN PAGE
    else
        applyGradient(Tab, Color3.fromRGB(90, 105, 130), Color3.fromRGB(60, 75, 100))
        local TxtStroke = Instance.new("UIStroke")
        TxtStroke.Thickness = 1
        TxtStroke.Color = Color3.fromRGB(0, 0, 0)
        TxtStroke.Parent = Tab
    end
    
    Tab.Parent = BottomBar
end

