-- ЛОГИКА ФУНКЦИЙ ИГРЫ (RenderStepped)
-- ===============================================
RunService.RenderStepped:Connect(function()
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    FOVCircle.Position = screenCenter
    FOVCircle.Visible = getgenv().Config.Aimbot and getgenv().Config.ShowFOV

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character
            local isEnemy = not player.Team or player.Team ~= LocalPlayer.Team

            -- ESP
            if getgenv().Config.ESP and isEnemy then
                if not char:FindFirstChild("XzeonaESP") then
                    local bb = Instance.new("BillboardGui", char)
                    bb.Name = "XzeonaESP"
                    bb.Size = UDim2.new(4, 0, 5.5, 0)
                    bb.AlwaysOnTop = true
                    local f = Instance.new("Frame", bb)
                    f.Size = UDim2.new(1, 0, 1, 0)
                    f.BackgroundTransparency = 1
                    local s = Instance.new("UIStroke", f)
                    s.Color = THEME.NeonPurple
                    s.Thickness = 2
                end
            elseif char:FindFirstChild("XzeonaESP") then
                char.XzeonaESP:Destroy()
            end

            -- Hitbox
            if getgenv().Config.Hitbox and isEnemy then
                local head = char:FindFirstChild("Head")
                if head and head:IsA("BasePart") then
                    head.Size = Vector3.new(getgenv().Config.HitboxSize, getgenv().Config.HitboxSize, getgenv().Config.HitboxSize)
                    head.Transparency = 0.6
                    head.CanCollide = false
                end
            end
        end
    end

    -- Легитный Аимбот
    if getgenv().Config.Aimbot then
        local closestHead = nil
        local shortestDist = getgenv().Config.AimbotFOV

        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and (not player.Team or player.Team ~= LocalPlayer.Team) then
                local head = player.Character:FindFirstChild("Head")
                local hum = player.Character:FindFirstChildOfClass("Humanoid")
                if head and hum and hum.Health > 0 then
                    local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
                    if onScreen then
                        local dist = (Vector2.new(pos.X, pos.Y) - screenCenter).Magnitude
                        if dist < shortestDist then
                            shortestDist = dist
                            closestHead = head
                        end
                    end
                end
            end
        end

        if closestHead then
            Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, closestHead.Position), 0.15)
        end
    end
end)

