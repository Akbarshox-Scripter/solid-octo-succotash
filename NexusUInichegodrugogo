-- ФУНКЦИОНАЛ ВЫПАДАЮЩЕГО СПИСКА И ЭЛЕМЕНТОВ
-- ===============================================
local Tabs = {}
local TabButtons = {}

local function CreateTab(name, index)
    local TabBtn = Instance.new("TextButton", Sidebar)
    TabBtn.Text = name
    TabBtn.Font = Enum.Font.GothamSemibold
    TabBtn.TextSize = 13
    TabBtn.TextColor3 = index == 1 and THEME.TextWhite or THEME.TextDark
    TabBtn.Size = UDim2.new(0.85, 0, 0, 36)
    TabBtn.Position = UDim2.new(0.075, 0, 0, 10 + ((index - 1) * 42))
    TabBtn.BackgroundTransparency = 1
    TabBtn.ZIndex = 2

    local Page = Instance.new("ScrollingFrame", ContentArea)
    Page.Size = UDim2.new(1, 0, 1, 0)
    Page.BackgroundTransparency = 1
    Page.Visible = (index == 1)
    Page.ScrollBarThickness = 2
    Page.ScrollBarImageColor3 = THEME.NeonPurple
    Page.BorderSizePixel = 0

    local Layout = Instance.new("UIListLayout", Page)
    Layout.Padding = UDim.new(0, 8)

    if index == 1 then
        TabIndicator.Position = TabBtn.Position
        TabIndicator.Visible = true
    end

    TabBtn.MouseButton1Click:Connect(function()
        for _, btn in pairs(TabButtons) do
            TweenService:Create(btn, TweenInfo.new(0.3), {TextColor3 = THEME.TextDark}):Play()
        end
        for _, p in pairs(Tabs) do p.Visible = false end

        TweenService:Create(TabIndicator, TweenInfo.new(0.5, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), {
            Position = TabBtn.Position
        }):Play()

        TweenService:Create(TabBtn, TweenInfo.new(0.3), {TextColor3 = THEME.TextWhite}):Play()
        Page.Visible = true
    end)

    table.insert(TabButtons, TabBtn)
    table.insert(Tabs, Page)
    return Page
end

-- ВЫПАДАЮЩАЯ «ЛЕСТНИЦА» (DROPDOWN) ДЛЯ АИМБОТА
local function CreateDropdown(parent, text, options, defaultConfigKey)
    local Card = Instance.new("Frame", parent)
    Card.Size = UDim2.new(0.96, 0, 0, 40)
    Card.BackgroundColor3 = THEME.CardBG
    Card.BackgroundTransparency = 0.4
    Card.ClipsDescendants = true
    Instance.new("UICorner", Card).CornerRadius = UDim.new(0, 8)

    local Header = Instance.new("TextButton", Card)
    Header.Size = UDim2.new(1, 0, 0, 40)
    Header.BackgroundTransparency = 1
    Header.Text = ""

    local Label = Instance.new("TextLabel", Header)
    Label.Text = text .. ": " .. getgenv().Config[defaultConfigKey]
    Label.Font = Enum.Font.GothamMedium
    Label.TextSize = 13
    Label.TextColor3 = THEME.TextWhite
    Label.Position = UDim2.new(0, 12, 0, 0)
    Label.Size = UDim2.new(0.7, 0, 1, 0)
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.BackgroundTransparency = 1

    local Arrow = Instance.new("TextLabel", Header)
    Arrow.Text = "▼"
    Arrow.Font = Enum.Font.GothamBold
    Arrow.TextSize = 12
    Arrow.TextColor3 = THEME.NeonPurple
    Arrow.Position = UDim2.new(1, -30, 0, 0)
    Arrow.Size = UDim2.new(0, 20, 1, 0)
    Arrow.BackgroundTransparency = 1

    local Container = Instance.new("Frame", Card)
    Container.Size = UDim2.new(1, 0, 0, #options * 30)
    Container.Position = UDim2.new(0, 0, 0, 40)
    Container.BackgroundTransparency = 1

    local isOpen = false

    Header.MouseButton1Click:Connect(function()
        isOpen = not isOpen
        local targetSize = isOpen and UDim2.new(0.96, 0, 0, 40 + (#options * 32)) or UDim2.new(0.96, 0, 0, 40)
        
        TweenService:Create(Card, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            Size = targetSize
        }):Play()

        TweenService:Create(Arrow, TweenInfo.new(0.3), {
            Rotation = isOpen and 180 or 0
        }):Play()
    end)

    for i, optText in ipairs(options) do
        local OptBtn = Instance.new("TextButton", Container)
        OptBtn.Size = UDim2.new(0.9, 0, 0, 28)
        OptBtn.Position = UDim2.new(0.05, 0, 0, (i - 1) * 32)
        OptBtn.BackgroundColor3 = Color3.fromRGB(40, 25, 65)
        OptBtn.Text = optText
        OptBtn.Font = Enum.Font.GothamSemibold
        OptBtn.TextColor3 = (optText == getgenv().Config[defaultConfigKey]) and THEME.NeonPurple or THEME.TextDark
        OptBtn.TextSize = 12
        Instance.new("UICorner", OptBtn).CornerRadius = UDim.new(0, 6)

        OptBtn.MouseButton1Click:Connect(function()
            getgenv().Config[defaultConfigKey] = optText
            Label.Text = text .. ": " .. optText
            
            for _, btn in pairs(Container:GetChildren()) do
                if btn:IsA("TextButton") then
                    btn.TextColor3 = (btn.Text == optText) and THEME.NeonPurple or THEME.TextDark
                end
            end

            isOpen = false
            TweenService:Create(Card, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                Size = UDim2.new(0.96, 0, 0, 40)
            }):Play()
            TweenService:Create(Arrow, TweenInfo.new(0.3), {Rotation = 0}):Play()
        end)
    end
end

