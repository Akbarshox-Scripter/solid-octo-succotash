-- Функция создания кнопок с ГРАДИЕНТАМИ
local function CreateCheatButton(name, desc, state)
    local Btn = Instance.new("TextButton")
    Btn.Name = name
    Btn.BackgroundColor3 = Color3.fromRGB(255, 255, 255) -- Белый фон для работы градиента
    
    if state == "Active" then
        applyGradient(Btn, Color3.fromRGB(110, 255, 50), Color3.fromRGB(10, 180, 10)) -- Зеленый градиент
    elseif state == "Blue" then
        applyGradient(Btn, Color3.fromRGB(80, 150, 255), Color3.fromRGB(10, 80, 220)) -- Синий градиент
    else
        applyGradient(Btn, Color3.fromRGB(170, 170, 180), Color3.fromRGB(90, 90, 100)) -- Серый градиент
    end
    
    local BtnCorner = Instance.new("UICorner")
    BtnCorner.CornerRadius = UDim.new(0, 4)
    BtnCorner.Parent = Btn
    
    local BtnStroke = Instance.new("UIStroke")
    BtnStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    BtnStroke.Thickness = 1.5
    BtnStroke.Color = Color3.fromRGB(0, 0, 0)
    BtnStroke.Parent = Btn
    
    local BtnTitle = Instance.new("TextLabel")
    BtnTitle.Size = UDim2.new(1, 0, 0.6, 0)
    BtnTitle.Position = UDim2.new(0, 0, 0.05, 0)
    BtnTitle.BackgroundTransparency = 1
    BtnTitle.Text = name
    BtnTitle.Font = Enum.Font.GothamBlack
    BtnTitle.TextSize = 13
    BtnTitle.TextColor3 = Color3.fromRGB(255, 255, 255)
    BtnTitle.Parent = Btn
    
    -- Градиент для текста (желтый, если активна)
    if state ~= "Inactive" then
        applyGradient(BtnTitle, Color3.fromRGB(255, 255, 100), Color3.fromRGB(255, 170, 0))
    else
        applyGradient(BtnTitle, Color3.fromRGB(200, 200, 200), Color3.fromRGB(130, 130, 130))
    end
    
    local TxtStroke = Instance.new("UIStroke")
    TxtStroke.Thickness = 1.2
    TxtStroke.Color = Color3.fromRGB(0, 0, 0)
    TxtStroke.Parent = BtnTitle

    local BtnDesc = Instance.new("TextLabel")
    BtnDesc.Size = UDim2.new(1, 0, 0.3, 0)
    BtnDesc.Position = UDim2.new(0, 0, 0.65, 0)
    BtnDesc.BackgroundTransparency = 1
    BtnDesc.Text = desc
    BtnDesc.Font = Enum.Font.GothamBold
    BtnDesc.TextSize = 6
    BtnDesc.TextColor3 = Color3.fromRGB(255, 255, 255)
    BtnDesc.Parent = Btn
    
    local DescStroke = Instance.new("UIStroke")
    DescStroke.Thickness = 1
    DescStroke.Color = Color3.fromRGB(0, 0, 0)
    DescStroke.Parent = BtnDesc
    
    Btn.Parent = ButtonContainer
end

