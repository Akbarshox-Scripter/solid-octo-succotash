-- РАБОЧИЙ ФЛАЙ
local flySpeed = 50
local flying = false
MakeTextBox(pages["Main"], "Fly Speed", function(val) flySpeed = tonumber(val) or 50 end)

MakeButton(pages["Main"], "Toggle Fly", function()
    flying = not flying
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    
    local hrp = char.HumanoidRootPart
    local hum = char:FindFirstChild("Humanoid")
    
    if flying then
        hum.PlatformStand = true
        local bp = Instance.new("BodyPosition", hrp)
        bp.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bp.Position = hrp.Position
        
        local bg = Instance.new("BodyGyro", hrp)
        bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        bg.CFrame = hrp.CFrame
        
        task.spawn(function()
            while flying do
                local camCFrame = Camera.CFrame
                local dir = Vector3.new()
                if UserInputService:IsKeyDown(Enum.KeyCode.W) or UserInputService:IsKeyDown(Enum.KeyCode.Up) then dir = dir + camCFrame.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) or UserInputService:IsKeyDown(Enum.KeyCode.Down) then dir = dir - camCFrame.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.D) or UserInputService:IsKeyDown(Enum.KeyCode.Right) then dir = dir + camCFrame.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.A) or UserInputService:IsKeyDown(Enum.KeyCode.Left) then dir = dir - camCFrame.RightVector end
                
                if hum.MoveDirection.Magnitude > 0 then
                    dir = Camera.CFrame:VectorToWorldSpace(Vector3.new(hum.MoveDirection.X, 0, hum.MoveDirection.Z))
                end
                
                bp.Position = bp.Position + (dir * (flySpeed / 10))
                bg.CFrame = camCFrame
                RunService.RenderStepped:Wait()
            end
            bp:Destroy()
            bg:Destroy()
            hum.PlatformStand = false
        end)
    else
        flying = false
        if hum then hum.PlatformStand = false end
    end
end)

