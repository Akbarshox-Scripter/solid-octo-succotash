LocalPlayer.Chatted:Connect(function(msg)
    local lowerMsg = string.lower(msg)
    if string.sub(lowerMsg, 1, 5) == "goto " then
        local target = string.sub(lowerMsg, 6)
        local targetPlayer = nil
        
        if target == "random" then
            local valid = {}
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    table.insert(valid, p)
                end
            end
            if #valid > 0 then targetPlayer = valid[math.random(1, #valid)] end
        else
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer then
                    if string.find(string.lower(p.Name), target) or string.find(string.lower(p.DisplayName), target) then
                        targetPlayer = p
                        break
                    end
                end
            end
        end
        
        if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character then
            LocalPlayer.Character.HumanoidRootPart.CFrame = targetPlayer.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, -3)
        end
    end
end)

