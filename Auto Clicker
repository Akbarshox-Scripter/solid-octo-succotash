-- Логика кликера
local isClicking = false
local clickDelay = 0.1
local targetCircles = {}

-- Обновление скорости
SpeedInput:GetPropertyChangedSignal("Text"):Connect(function()
    local val = tonumber(SpeedInput.Text)
    if val then
        clickDelay = val
    end
end)

-- Переключение On/Off
ToggleBtn.MouseButton1Click:Connect(function()
    isClicking = not isClicking
    if isClicking then
        ToggleBtn.Text = "CLICKER: ON"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
    else
        ToggleBtn.Text = "CLICKER: OFF"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    end
end)

-- Спавн кружка "Т"
AddBtn.MouseButton1Click:Connect(function()
    local TargetCircle = Instance.new("Frame")
    TargetCircle.Size = UDim2.new(0, 35, 0, 35)
    TargetCircle.Position = UDim2.new(0.5, -17, 0.5, -17)
    TargetCircle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    TargetCircle.BackgroundTransparency = 0.4
    TargetCircle.ZIndex = 5
    TargetCircle.Parent = ScreenGui
    makeDraggable(TargetCircle)

    local CircleCorner = Instance.new("UICorner")
    CircleCorner.CornerRadius = UDim.new(1, 0) -- Делаем идеальный круг
    CircleCorner.Parent = TargetCircle

    local CircleStroke = Instance.new("UIStroke")
    CircleStroke.Thickness = 1.5
    CircleStroke.Color = Color3.fromRGB(255, 255, 255)
    CircleStroke.Parent = TargetCircle

    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(1, 0, 1, 0)
    Label.BackgroundTransparency = 1
    Label.Text = "T"
    Label.TextColor3 = Color3.fromRGB(255, 255, 255)
    Label.Font = Enum.Font.GothamBold
    Label.TextSize = 16
    Label.Parent = TargetCircle

    -- Добавляем в таблицу живых мишеней
    table.insert(targetCircles, TargetCircle)
    
    -- Правый клик / долгое нажатие удаляет таргет, чтоб не забивать экран
    TargetCircle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton2 then
            for i, v in ipairs(targetCircles) do
                if v == TargetCircle then
                    table.remove(targetCircles, i)
                    break
                end
            end
            TargetCircle:Destroy()
        end
    end)
end)

-- Воркер кликов через поток
task.spawn(function()
    while true do
        if isClicking and #targetCircles > 0 then
            for _, circle in ipairs(targetCircles) do
                if circle and circle.Parent then
                    -- Считаем центр кружка на экране
                    local x = circle.AbsolutePosition.X + (circle.AbsoluteSize.X / 2)
                    local y = circle.AbsolutePosition.Y + (circle.AbsoluteSize.Y / 2) + 36 -- смещение топбара Roblox
                    
                    -- Симулируем клик мыши
                    VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 1)
                    task.wait(0.005)
                    VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 1)
                end
            end
        end
        task.wait(clickDelay)
    end
end)
